LANGUAGE=go

# Your receiver/owner address.
INITIAL_OWNER="0x21b805BBC4bfFA7769868BF7f488D77b71756d3E"

# Required: funded Coston2 private key for INITIAL_OWNER, hex without 0x.
DEPLOYMENT_PRIVATE_KEY="<funded-coston2-private-key-hex-no-0x>"

# Required: funded key used by ext-proxy signing. Can be the same key for testnet.
PROXY_PRIVATE_KEY="<funded-coston2-private-key-hex-no-0x>"

CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
ADDRESSES_FILE=./config/coston2/deployed-addresses.json
LOCAL_MODE=false
SIMULATED_TEE=true
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# Required: public HTTPS tunnel to local port 6674.
EXT_PROXY_URL="https://<your-ngrok-or-cloudflared-domain>"

# Required: copy the Coston2 proxy TOML examples and fill [db] indexer credentials.
# See config/proxy/extension_proxy.coston2.*.toml.example.
