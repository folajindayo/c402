app = "c402-dashboard"
primary_region = "iad"

[build]
  dockerfile = "deploy/docker/dashboard.Dockerfile"

[env]
  HOST = "0.0.0.0"
  DASHBOARD_PORT = "4022"
  C402_BASE_URL = "https://c402-api.fly.dev"

[[services]]
  internal_port = 4022
  protocol = "tcp"
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

  [[services.ports]]
    port = 80
    handlers = ["http"]

  [[services.ports]]
    port = 443
    handlers = ["tls", "http"]
