{
  "name": "c402",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "find apps packages -type d \\( -name dist -o -name .tsbuildinfo \\) -prune -exec rm -rf {} +",
    "dev:api": "npm run dev -w @c402/api",
    "dev:dashboard": "npm run dev -w @c402/dashboard",
    "docker:build": "docker build -f deploy/docker/api.Dockerfile -t c402-api:local . && docker build -f deploy/docker/dashboard.Dockerfile -t c402-dashboard:local .",
    "deploy:compose": "docker compose -f deploy/compose/compose.prod.yaml --env-file .env.production up -d --build",
    "check": "npm run build && forge build",
    "test": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "@x402/fetch": "^2.20.0",
    "viem": "^2.48.11"
  }
}
